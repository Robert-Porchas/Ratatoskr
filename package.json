{
  "name": "ratatoskr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "tsx test/integration.ts",
    "test:mcp": "npm run build && node dist/test/mcp-integration.js",
    "test:benchmark": "npm run build && node dist/test/benchmark-integration.js",
    "cli": "tsx src/cli.ts",
    "mcp": "node dist/src/mcp/server.js",
    "fixture": "tsx test/fixture/server.ts",
    "benchmark:browser": "npm run build && node dist/benchmarks/browser-evidence/run.js",
    "benchmark:browser:baseline": "npm run benchmark:browser -- baseline",
    "benchmark:browser:ratatoskr": "npm run benchmark:browser -- ratatoskr",
    "benchmark:browser:summary": "tsx benchmarks/browser-evidence/summary.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "playwright": "^1.55.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^24.5.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
